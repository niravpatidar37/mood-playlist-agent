# Required – get a free key at console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional – Hugging Face Inference Providers (select an hf: model in the UI)
HF_TOKEN=your_huggingface_token_here
# HF_API_URL=https://router.huggingface.co/v1/chat/completions

# Optional – LangSmith tracing and evaluation
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=vibeforge-development
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Optional – Spotify (for direct track links)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Optional – OpenWeatherMap (for weather-aware recommendations)
OPENWEATHER_API_KEY=your_openweather_api_key
OPENWEATHER_CITY=Mumbai

# Optional – Redis (shared generation cache across multiple API workers/processes;
# without it, each process falls back to its own in-memory cache)
# REDIS_URL=redis://localhost:6379/0
